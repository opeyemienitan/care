# Nothing below is required for local development — the app runs fully
# functional demo/mock behaviour with zero configuration. Set what you have;
# everything else degrades gracefully. See README.md > "Environment variables"
# for exactly what each one unlocks.

# --- Production database (Turso) ---
# Required for Vercel deployment (Vercel's filesystem is ephemeral, so the
# local node:sqlite file can't be used there). Not needed for local dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Session security ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# --- AI (Claude) ---
# Powers specialism tag suggestions, match narratives, and safeguarding
# report triage. Falls back to deterministic keyword logic when unset.
ANTHROPIC_API_KEY=

# --- Email (Resend) ---
# Falls back to an inspectable email_outbox database table when unset.
RESEND_API_KEY=
EMAIL_FROM="Marram Care <notifications@marramcare.co.uk>"

# --- Payments (Stripe) ---
# Falls back to a fully worked mock Stripe Connect adapter when unset.
STRIPE_SECRET_KEY=

# --- File storage ---
# Set to "s3" to signal the S3/R2 swap-in point (adapter still needs
# implementing in src/lib/storage.ts). Falls back to local disk otherwise.
STORAGE_PROVIDER=

# --- Site URL ---
# Used for canonical URLs, the sitemap, and links in outbound emails.
NEXT_PUBLIC_SITE_URL=https://marramcare.co.uk

# --- Analytics / ads (optional) ---
# Only loaded client-side after a visitor accepts the cookie consent banner.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
